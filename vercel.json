{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix 5_frontend_hud ci && npm --prefix 5_frontend_hud run build && node scripts/copy-frontend.mjs",
  "functions": {
    "main.py": {
      "includeFiles": "3_backend_core/*.py"
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
