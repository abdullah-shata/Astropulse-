{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-core": {
      "root": "3_backend_core",
      "framework": "fastapi"
    },
    "frontend-hud": {
      "root": "5_frontend_hud",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://backend-core/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "http://frontend-hud/:path*"
    }
  ]
}
